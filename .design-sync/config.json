{
  "pkg": "web-app",
  "globalName": "MDesign",
  "shape": "package",
  "buildCmd": "npx vite build --config .design-sync/vite.ds.config.js",
  "srcDir": "src",
  "tsconfig": "jsconfig.json",
  "cssEntry": ".design-sync/.cache/dist/style.css",
  "provider": { "component": "LanguageProvider" },
  "componentSrcMap": {
    "Button": "src/components/ui/button.jsx",
    "Card": "src/components/ui/card.jsx",
    "CardHeader": "src/components/ui/card.jsx",
    "CardTitle": "src/components/ui/card.jsx",
    "CardDescription": "src/components/ui/card.jsx",
    "CardContent": "src/components/ui/card.jsx",
    "CardFooter": "src/components/ui/card.jsx",
    "Toast": "src/components/ui/toast.jsx",
    "ToastAction": "src/components/ui/toast.jsx",
    "ToastClose": "src/components/ui/toast.jsx",
    "ToastTitle": "src/components/ui/toast.jsx",
    "ToastDescription": "src/components/ui/toast.jsx",
    "ToastViewport": "src/components/ui/toast.jsx",
    "Toaster": "src/components/ui/toaster.jsx",
    "Header": "src/components/Header.jsx",
    "Footer": "src/components/Footer.jsx",
    "SectionWrapper": "src/components/SectionWrapper.jsx",
    "ImageLightbox": "src/components/ImageLightbox.jsx"
  }
}
